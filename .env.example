APP_NAME=ecoop
APP_SECRET=z4vOtUL7UxC58PjB8muhAD8b1G78lq3sYox7jGHcIATUQgbb1p2evsTsIzMckobM
# Password hashing (Argon2id). These are RFC 9106's second recommended profile;
# a value below the minimum (salt and key 16 bytes, one iteration) stops the app.
SECURITY_MEMORY_KIB=65536
SECURITY_ITERATIONS=3
SECURITY_PARALLELISM=4
SECURITY_SALT_BYTES=16
SECURITY_KEY_BYTES=32
APP_VERSION=dev
APP_ENV=development

# debug, info, warn or error. Anything else stops the app at startup.
LOG_LEVEL=info

# Telemetry (OpenTelemetry over OTLP/HTTP). Leave the endpoint empty to export
# nothing: the app still records in memory and works. A value that is set but
# malformed stops the app at startup rather than being ignored.
#   docker compose --profile telemetry up -d otel-collector prometheus tempo grafana
#   starts a local collector (http://127.0.0.1:14318), Prometheus (:9090),
#   Tempo and Grafana (http://127.0.0.1:3000). Set the endpoint to
#   http://127.0.0.1:14318 and OTEL_EXPORTER_OTLP_INSECURE=true to use it.
OTEL_EXPORTER_OTLP_ENDPOINT=
# An http:// endpoint is refused unless this is true; use https:// across a network.
OTEL_EXPORTER_OTLP_INSECURE=false
# k=v,k2=v2 sent with every export, for a hosted backend's API key.
OTEL_EXPORTER_OTLP_HEADERS=
# Production default: keep the parent's decision, sample 10% of new traces.
# Metrics are never sampled. Development: always_on.
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
OTEL_SDK_DISABLED=false

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=ecoop
POSTGRES_PASSWORD=ecoop
POSTGRES_DB=ecoop
POSTGRES_SSLMODE=disable
POSTGRES_MAX_CONNECTIONS=200
# A directory of goose .sql files, and whether pending ones are applied at start.
POSTGRES_MIGRATIONS_DIR=
POSTGRES_AUTO_MIGRATE=false

# CQRS read model: a second Postgres the app replicates into (not a CDC source).
POSTGRES_READ_HOST=127.0.0.1
POSTGRES_READ_PORT=5433
POSTGRES_READ_USER=ecoop
POSTGRES_READ_PASSWORD=ecoop
POSTGRES_READ_DB=ecoop_read
POSTGRES_READ_MAX_CONNECTIONS=200

CACHE_DRIVER=valkey
CACHE_HOST=127.0.0.1
CACHE_PORT=6379
CACHE_PASSWORD=ecoop-test

# Isolates this app's jobs from others on the same Valkey. Replicas of one app
# share a value. Empty means none.
QUEUE_NAMESPACE=

SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@ecoop.test
SMTP_FROM_NAME=eCoop
SMTP_SECURED=true

# Twilio. Account SID and token are required only when SMS_SECURED is true.
SMS_SENDER=+15005550006
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_MAX_CHARACTERS=160
SMS_SECURED=false
MAILPIT_UI_PORT=8025

STORAGE_DRIVER=rustfs
STORAGE_HOST=127.0.0.1
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001
STORAGE_PUBLIC_ENDPOINT=
STORAGE_ACCESS_KEY=ecoop
STORAGE_SECRET_KEY=ecoop-secret
STORAGE_BUCKET=ecoop
STORAGE_REGION=us-east-1
STORAGE_SECURED=false
STORAGE_MAX_FILE_SIZE=104857600
STORAGE_URL_TIMEOUT=30s

BROADCAST_HOST=127.0.0.1
BROADCAST_PORT=6001
BROADCAST_SECURED=false
BROADCAST_APP_ID=ecoop
BROADCAST_APP_KEY=ecoop-key
BROADCAST_APP_SECRET=ecoop-secret
BROADCAST_MAX_PAYLOAD_KB=5120
BROADCAST_REDIS_DB=2
BROADCAST_DEBUG=false

PDF_ENGINE_API_PORT=6767
PDF_ENGINE_API_HOST=127.0.0.1
PDF_ENGINE_API_BEARER_TOKEN=90UA0Kh8VfWEAKMmACPKKV6SMwgV7m9o4ItcpX2ZSpe9dYQcUlh7tzptYJveyDPe
PDF_ENGINE_API_URL=http://${PDF_ENGINE_API_HOST}:${PDF_ENGINE_API_PORT}

PDF_BUCKET=pdfs
PDF_IMAGE_TAG=1.1.0
PDF_RENDER_TIMEOUT_SECS=45

BROKER_HOST=127.0.0.1
BROKER_PORT=9094
BROKER_GROUP_ID=ecoop
BROKER_IMAGE_TAG=latest

# Debezium (Postgres CDC -> the same Kafka as above). Topics come out as
# <CDC_TOPIC_PREFIX>.<schema>.<table>; dead letters as <topic>.dlq.

CDC_HOST=127.0.0.1
CDC_PORT=8083
CDC_IMAGE_TAG=3.0
CDC_CONNECT_GROUP_ID=ecoop-connect
CDC_CONNECTOR_NAME=ecoop-postgres
CDC_TOPIC_PREFIX=ecoop
# The app's consumer group for change events; empty uses BROKER_GROUP_ID.
CDC_GROUP_ID=
CDC_TABLE_INCLUDE_LIST=public.users
CDC_SLOT_NAME=ecoop_debezium
CDC_PUBLICATION_NAME=ecoop_debezium
CDC_SNAPSHOT_MODE=initial
# Partitions per Debezium topic. The row key is the primary key, so one row
# always lands in one partition and keeps its order; more partitions let more
# app replicas share the stream. Applies to topics created after the change.
CDC_TOPIC_PARTITIONS=3
# Debezium sets this replica identity on the captured tables (regex:IDENTITY,...).
# The CQRS read model needs FULL so an update always carries every column.
CDC_REPLICA_IDENTITY_AUTOSET=.*:FULL
CDC_REPLICATION_FACTOR=1
# Replication user; empty falls back to POSTGRES_USER / POSTGRES_PASSWORD.
CDC_DB_USER=
CDC_DB_PASSWORD=

# API. The defaults are the development profile: not secured, any host, no
# CORS origins. In production set API_SECURED=true; the server then refuses to
# start without https origins and a rate limit, and refuses pprof.
API_ADDR=0.0.0.0:8080
API_SECURED=false
# Browser origins (scheme://host[:port], no path, no trailing slash). One
# environment's origins only; https only when secured.
API_ALLOWED_ORIGINS=
# Host header values the API answers to. Empty means the hosts of the origins.
API_ALLOWED_HOSTS=
# Networks whose X-Forwarded-For / X-Forwarded-Proto are believed (CIDR or IP).
# Empty trusts nobody. 0.0.0.0/0 is refused.
API_TRUSTED_PROXIES=
API_MAX_BODY_BYTES=1048576
API_MAX_STREAMS=256
API_STREAM_TIMEOUT=10m
API_RATE_LIMIT=10
API_RATE_BURST=30
API_READ_TIMEOUT=15s
API_WRITE_TIMEOUT=30s
API_IDLE_TIMEOUT=60s
API_SHUTDOWN_TIMEOUT=30s
# Developer machine only: loopback clients can reach /debug/pprof.
API_ENABLE_PPROF=false
API_BLOCK_SUSPICIOUS=true
