# Copy to .env:  cp .env.example .env
# Values below match docker-compose.yml. Hosts use localhost so `go run .` works;
# docker-compose overrides them with container names for the `app` service.

# --- App ---
APP_NAME=ecoop-server
APP_PORT=8080
GRPC_PORT=9090
# HTTPS: set both to serve TLS directly (leave empty behind a TLS-terminating proxy).
TLS_CERT_FILE=
TLS_KEY_FILE=
APP_ENV=development
# LOG_LEVEL: debug | info | warn | error
LOG_LEVEL=debug
# LOG_FORMAT: console | json
LOG_FORMAT=console

# --- OpenTelemetry (Grafana LGTM: Tempo traces + Loki logs) ---
# http:// means plaintext gRPC, which is what the local collector expects.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=development

# --- PostgreSQL ---
POSTGRES_USER=ecoop
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ecoop
# Writer (all writes). Reader (plain reads; lags the writer via CDC in prod) — same DB locally.
DATABASE_URL=postgres://ecoop:change-me@localhost:5432/ecoop?sslmode=disable
DATABASE_READER_URL=postgres://ecoop:change-me@localhost:5432/ecoop?sslmode=disable

# --- Redis ---
REDIS_ADDR=localhost:6379

# --- Kafka ---
KAFKA_BROKER=localhost:9094

# --- Pusher protocol (Sockudo locally) ---
PUSHER_APP_ID=ecoop-app
PUSHER_KEY=ecoop-key
PUSHER_SECRET=change-me
PUSHER_HOST=localhost:6001
PUSHER_SECURE=false
