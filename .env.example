BROKER_IMAGE_TAG=latest

# Debezium (Postgres CDC -> the same Kafka as above). Topics come out as
# <CDC_TOPIC_PREFIX>.<schema>.<table>; dead letters as <topic>.dlq.

CDC_HOST=127.0.0.1
CDC_PORT=8083
CDC_IMAGE_TAG=3.0
CDC_CONNECT_GROUP_ID=ecoop-connect
CDC_CONNECTOR_NAME=ecoop-postgres
CDC_TOPIC_PREFIX=ecoop
CDC_TABLE_INCLUDE_LIST=public.users
CDC_SLOT_NAME=ecoop_debezium
CDC_PUBLICATION_NAME=ecoop_debezium
CDC_SNAPSHOT_MODE=initial
# Partitions per Debezium topic. The row key is the primary key, so one row
# always lands in one partition and keeps its order; more partitions let more
# app replicas share the stream. Applies to topics created after the change.
CDC_TOPIC_PARTITIONS=3
# Debezium sets this replica identity on the captured tables (regex:IDENTITY,...).
# The CQRS read model needs FULL so an update always carries every column.
CDC_REPLICA_IDENTITY_AUTOSET=.*:FULL
CDC_REPLICATION_FACTOR=1
# Replication user; empty falls back to POSTGRES_USER / POSTGRES_PASSWORD.
CDC_DB_USER=
CDC_DB_PASSWORD=
