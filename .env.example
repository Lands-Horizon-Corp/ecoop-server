APP_CLIENT_URL=http://127.0.0.1:3000
APP_CLIENT_NAME=horizon

# ==============================================================================
# 2. DATABASE: PHYSICAL INSTANCES (Docker Containers)
# ==============================================================================
# PRIMARY APP DB (Internal Port: 5432)
POSTGRES_USER=dev
POSTGRES_PASSWORD=devpass
POSTGRES_DB=devdb
POSTGRES_PORT=5432
POSTGRES_HOST=127.0.0.1

# ADMIN DB (Internal Port: 5432)
ADMIN_POSTGRES_USER=admin_user
ADMIN_POSTGRES_PASSWORD=adminpass
ADMIN_POSTGRES_DB=admin_devdb
ADMIN_POSTGRES_PORT=5433
ADMIN_POSTGRES_HOST=127.0.0.1

# CITUS DB (Internal Port: 5432)
CITUS_POSTGRES_USER=citus_user
CITUS_POSTGRES_PASSWORD=cituspass
CITUS_POSTGRES_DB=citus_devdb
CITUS_POSTGRES_PORT=5434
CITUS_POSTGRES_HOST=127.0.0.1

# ==============================================================================
# 3. DATABASE: PGBOUNCER (Gateway & Pooling)
# ==============================================================================
PGBOUNCER_HOST=127.0.0.1
PGBOUNCER_PORT=6432
PGBOUNCER_MAX_CLIENT_CONN=1000
PGBOUNCER_DEFAULT_POOL_SIZE=20
PGBOUNCER_POOL_MODE=transaction

# ==============================================================================
# 4. DATABASE: GOLANG CONNECTION STRINGS (DSN)
# ==============================================================================
# Application DSN (Routes through PgBouncer to 'citus_db')
DATABASE_URL="host=${PGBOUNCER_HOST} port=${PGBOUNCER_PORT} user=${CITUS_POSTGRES_USER} password=${CITUS_POSTGRES_PASSWORD} dbname=citus_db sslmode=disable default_query_exec_mode=exec"

# Admin Dashboard DSN (Routes through PgBouncer to 'citus_db')
ADMIN_DATABASE_URL="host=${PGBOUNCER_HOST} port=${PGBOUNCER_PORT} user=${CITUS_POSTGRES_USER} password=${CITUS_POSTGRES_PASSWORD} dbname=citus_db sslmode=disable default_query_exec_mode=exec"

# Connection Pooling Tuning for GORM
DATABASE_MAX_IDLE_CONN=5
DATABASE_MAX_OPEN_CONN=20
DATABASE_MAX_LIFETIME=3600

