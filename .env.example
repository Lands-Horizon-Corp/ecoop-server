# ==============================================================================
# 11. OBSERVABILITY (OpenTelemetry LGTM Stack)
# ==============================================================================
GRAFANA_PORT=3001
# Note: The otel-lgtm image hardcodes the default grafana password to admin, 
# so GF_SECURITY_ADMIN_PASSWORD won't take effect via env var in this specific image.
# You will log in with admin/admin on first boot.

# OTLP Collector Endpoints
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# App-level OTel Configuration for your Golang service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=horizon-app
OTEL_RESOURCE_ATTRIBUTES=service.namespace=horizon,deployment.environment=development

# ==============================================================================
# 12. KAFKA (Message Streaming)
# ==============================================================================
ZOOKEEPER_CLIENT_PORT=2181
ZOOKEEPER_PORT=2181
ZOOKEEPER_SYNC_LIMIT=5
ZOOKEEPER_INIT_LIMIT=10

KAFKA_BROKER_ID=1
KAFKA_INTERNAL_PORT=29092
KAFKA_EXTERNAL_PORT=9092
KAFKA_REPLICATION_FACTOR=1
KAFKA_AUTO_CREATE_TOPICS=true
KAFKA_LOG_RETENTION_HOURS=168
KAFKA_HOST=127.0.0.1

# ==============================================================================
# 13. SONARQUBE (Code Quality / Static Analysis)
# ==============================================================================
SONARQUBE_PORT=9050
SONARQUBE_POSTGRES_USER=sonar_user
SONARQUBE_POSTGRES_PASSWORD=sonarpass
SONARQUBE_POSTGRES_DB=sonarqube_devdb