PDF_BUCKET=pdfs
PDF_IMAGE_TAG=1.1.0
PDF_RENDER_TIMEOUT_SECS=45

BROKER_HOST=127.0.0.1
BROKER_PORT=9094
BROKER_GROUP_ID=ecoop
BROKER_IMAGE_TAG=latest

# Debezium (Postgres CDC -> the same Kafka as above). Topics come out as
# <DEBEZIUM_TOPIC_PREFIX>.<schema>.<table>; dead letters as <topic><BROKER_DLQ_SUFFIX>.
BROKER_BOOTSTRAP_SERVERS=
BROKER_DLQ_SUFFIX=.dlq
BROKER_HANDLER_ATTEMPTS=3
BROKER_RETRY_BACKOFF=200ms

DEBEZIUM_HOST=127.0.0.1
DEBEZIUM_PORT=8083
DEBEZIUM_IMAGE_TAG=3.0
DEBEZIUM_CONNECT_GROUP_ID=ecoop-connect
DEBEZIUM_CONNECTOR_NAME=ecoop-postgres
DEBEZIUM_TOPIC_PREFIX=ecoop
DEBEZIUM_TABLE_INCLUDE_LIST=public.users
DEBEZIUM_SLOT_NAME=ecoop_debezium
DEBEZIUM_PUBLICATION_NAME=ecoop_debezium
DEBEZIUM_SNAPSHOT_MODE=initial
DEBEZIUM_TOPIC_PARTITIONS=1
DEBEZIUM_REPLICATION_FACTOR=1
# Replication user; empty falls back to POSTGRES_USER / POSTGRES_PASSWORD.
DEBEZIUM_DB_USER=
DEBEZIUM_DB_PASSWORD=
