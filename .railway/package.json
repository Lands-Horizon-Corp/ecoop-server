{
  "name": "railway-app",
  "version": "1.0.0",
  "description": "deployment",
  "keywords": [],
  "homepage": "https://github.com/Lands-Horizon-Corp/ecoop-server#readme",
  "bugs": {
    "url": "https://github.com/Lands-Horizon-Corp/ecoop-server/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lands-Horizon-Corp/ecoop-server.git"
  },
  "license": "ISC",
  "author": "lands-horizon",
  "type": "module",
  "main": "index.js",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "setup": "zsh -ic 'nvm use && bun install && railway login'",
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^26.6.2",
    "bun-types": "1.4.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "railway": "3.11.0"
  }
}
