{
    "uid": "ecoop-observability",
    "title": "ecoop-server / operations",
    "description": "What every internal/pkg package reports through the observability package: operations_total, operation_duration_seconds, inflight_operations and the cqrs_* totals. Needs an exporter that sends them to Prometheus; until one exists this dashboard is empty.",
    "tags": [
        "ecoop",
        "go",
        "observability"
    ],
    "timezone": "browser",
    "refresh": "10s",
    "schemaVersion": 39,
    "editable": true,
    "time": {
        "from": "now-30m",
        "to": "now"
    },
    "templating": {
        "list": [
            {
                "name": "service",
                "label": "Service",
                "type": "query",
                "datasource": {
                    "type": "prometheus",
                    "uid": "prometheus"
                },
                "query": {
                    "query": "label_values(operations_total, job)",
                    "refId": "service"
                },
                "definition": "label_values(operations_total, job)",
                "current": {
                    "text": "e-coop/ecoop",
                    "value": "e-coop/ecoop"
                },
                "refresh": 2
            },
            {
                "name": "component",
                "label": "Component",
                "type": "query",
                "datasource": {
                    "type": "prometheus",
                    "uid": "prometheus"
                },
                "query": {
                    "query": "label_values(operations_total{job=\"$service\"}, component)",
                    "refId": "component"
                },
                "definition": "label_values(operations_total{job=\"$service\"}, component)",
                "includeAll": true,
                "multi": true,
                "allValue": ".*",
                "current": {
                    "text": "All",
                    "value": "$__all"
                },
                "refresh": 2
            }
        ]
    },
    "panels": [
        {
            "type": "row",
            "title": "Overview",
            "id": 1,
            "collapsed": false,
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 0
            },
            "panels": []
        },
        {
            "type": "stat",
            "title": "Operations / s",
            "id": 2,
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 4,
                "w": 4,
                "x": 0,
                "y": 1
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "ops",
                    "decimals": 1
                },
                "overrides": []
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "refId": "A",
                    "expr": "sum(rate(operations_total{job=\"$service\",component=~\"$component\"}[$__rate_interval]))"
                }
            ]
        },
        {
            "type": "stat",
            "title": "Error rate",
            "id": 3,
            "description": "Faults only. Expected answers (a cache miss, a wrong password, a duplicate) end as skipped and are not counted here.",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 4,
                "w": 4,
                "x": 4,
                "y": 1
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "percentunit",
                    "decimals": 2,
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "orange",
                                "value": 0.01
                            },
                            {
                                "color": "red",
                                "value": 0.05
                            }
                        ]
                    }
                },
                "overrides": []
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "refId": "A",
                    "expr": "sum(rate(operations_total{job=\"$service\",component=~\"$component\",outcome=\"error\"}[$__rate_interval])) / sum(rate(operations_total{job=\"$service\",component=~\"$component\"}[$__rate_interval]))"
                }
            ]
        },
        {
            "type": "stat",
            "title": "In flight",
            "id": 4,
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 4,
                "w": 4,
                "x": 8,
                "y": 1
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "refId": "A",
                    "expr": "sum(inflight_operations{job=\"$service\",component=~\"$component\"})"
                }
            ]
        },
        {
            "type": "stat",
            "title": "Retries / s",
            "id": 5,
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 4,
                "w": 4,
                "x": 12,
                "y": 1
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "ops",
                    "decimals": 2
                },
                "overrides": []
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "refId": "A",
                    "expr": "sum(rate(operations_total{job=\"$service\",component=~\"$component\",outcome=\"retry\"}[$__rate_interval]))"
                }
            ]
        },
        {
            "type": "stat",
            "title": "Dead-lettered / s",
            "id": 6,
            "description": "Records parked on a dead-letter topic. Anything above zero needs a look.",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 4,
                "w": 4,
                "x": 16,
                "y": 1
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "ops",
                    "decimals": 2,
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "red",
                                "value": 0.0001
                            }
                        ]
                    }
                },
                "overrides": []
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "refId": "A",
                    "expr": "sum(rate(operations_total{job=\"$service\",component=~\"$component\",outcome=\"dlq\"}[$__rate_interval]))"
                }
            ]
        },
        {
            "type": "stat",
            "title": "Series cap hit",
            "id": 7,
            "description": "Above zero means a label that should be bounded is not: its series were folded into one overflow series per component. Find the label and fix the caller.",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 4,
                "w": 4,
                "x": 20,
                "y": 1
            },
            "fieldConfig": {
                "defaults": {
                    "decimals": 0,
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "red",
                                "value": 1
                            }
                        ]
                    }
                },
                "overrides": []
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "refId": "A",
                    "expr": "sum(operations_total{job=\"$service\",overflow=\"true\"}) or vector(0)"
                }
            ]
        },
        {
            "type": "row",
            "title": "By component",
            "id": 10,
            "collapsed": false,
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 5
            },
            "panels": []
        },
        {
            "type": "timeseries",
            "title": "Operations / s by component",
            "id": 11,
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 6
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "ops"
                },
                "overrides": []
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "refId": "A",
                    "legendFormat": "{{component}}",
                    "expr": "sum by (component) (rate(operations_total{job=\"$service\",component=~\"$component\"}[$__rate_interval]))"
                }
            ]
        },
        {
            "type": "timeseries",
            "title": "Error rate by component",
            "id": 12,
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 6
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "percentunit",
                    "min": 0
                },
                "overrides": []
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "refId": "A",
                    "legendFormat": "{{component}}",
                    "expr": "sum by (component) (rate(operations_total{job=\"$service\",component=~\"$component\",outcome=\"error\"}[$__rate_interval])) / sum by (component) (rate(operations_total{job=\"$service\",component=~\"$component\"}[$__rate_interval]))"
                }
            ]
        },
        {
            "type": "timeseries",
            "title": "p95 duration by component",
            "id": 13,
            "description": "95th percentile, from the operation_duration_seconds buckets (1 ms to 5 min). An average hides the slow tail; this shows it.",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 14
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "s"
                },
                "overrides": []
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "refId": "A",
                    "legendFormat": "{{component}} p95",
                    "expr": "histogram_quantile(0.95, sum by (le, component) (rate(operation_duration_seconds_bucket{job=\"$service\",component=~\"$component\"}[$__rate_interval])))"
                },
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "refId": "B",
                    "legendFormat": "{{component}} p99",
                    "expr": "histogram_quantile(0.99, sum by (le, component) (rate(operation_duration_seconds_bucket{job=\"$service\",component=~\"$component\"}[$__rate_interval])))"
                }
            ]
        },
        {
            "type": "timeseries",
            "title": "In flight by component",
            "id": 14,
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 14
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "refId": "A",
                    "legendFormat": "{{component}}",
                    "expr": "sum by (component) (inflight_operations{job=\"$service\",component=~\"$component\"})"
                }
            ]
        },
        {
            "type": "timeseries",
            "title": "Outcomes",
            "id": 15,
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 22
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "ops",
                    "custom": {
