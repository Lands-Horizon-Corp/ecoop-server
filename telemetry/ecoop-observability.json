                "overrides": []
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "refId": "A",
                    "legendFormat": "{{outcome}}",
                    "expr": "sum by (outcome) (rate(operations_total{job=\"$service\",component=~\"$component\"}[$__rate_interval]))"
                }
            ]
        },
        {
            "type": "table",
            "title": "Worst operations (errors / s)",
            "id": 16,
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 22
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "ops",
                    "decimals": 3
                },
                "overrides": []
            },
            "options": {
                "sortBy": [
                    {
                        "displayName": "Value",
                        "desc": true
                    }
                ]
            },
            "transformations": [
                {
                    "id": "organize",
                    "options": {
                        "excludeByName": {
                            "Time": true
                        }
                    }
                }
            ],
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "refId": "A",
                    "format": "table",
                    "instant": true,
                    "expr": "topk(15, sum by (component, operation) (rate(operations_total{job=\"$service\",component=~\"$component\",outcome=\"error\"}[$__rate_interval])) > 0)"
                }
            ]
        },
